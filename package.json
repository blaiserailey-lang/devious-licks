{
  "name": "devious-licks",
  "productName": "Devious Licks",
  "version": "0.3.1",
  "description": "The Devious Licks game library: every Devious Licks game, kept up to date, with a built-in emulator.",
  "main": "src/main.js",
  "private": true,
  "license": "UNLICENSED",
  "author": "Devious Licks",
  "deviousLicks": {
    "catalog": {
      "owner": "blaiserailey-lang",
      "repo": "devious-licks",
      "branch": "main",
      "path": "catalog"
    }
  },
  "scripts": {
    "postinstall": "node scripts/vendor-emulator.js",
    "start": "electron .",
    "start:local": "DL_CATALOG_DIR=./catalog electron .",
    "catalog": "node scripts/update-catalog.js",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --mac dmg --universal --publish never"
  },
  "build": {
    "appId": "com.deviouslicks.library",
    "productName": "Devious Licks",
    "files": [
      "src/**/*",
      "vendor/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "x64ArchFiles": "Contents/Resources/player/*"
    },
    "dmg": {
      "artifactName": "Devious-Licks-${version}.dmg"
    },
    "extraResources": [
      {
        "from": "player/dist",
        "to": "player",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "@emulatorjs/core-fceumm": "4.2.3",
    "@emulatorjs/core-gambatte": "4.2.3",
    "@emulatorjs/core-genesis_plus_gx": "4.2.3",
    "@emulatorjs/core-mgba": "4.2.3",
    "@emulatorjs/core-mupen64plus_next": "4.2.3",
    "@emulatorjs/core-snes9x": "4.2.3",
    "@emulatorjs/emulatorjs": "4.2.3",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
